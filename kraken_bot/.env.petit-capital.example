# Profil "petit capital" (≈ 50 €). Usage : cp .env.petit-capital.example .env
# Les paramètres absents gardent les valeurs par défaut (voir .env.example).

# --- Clés API Kraken (à créer toi-même, jamais à partager) -------------------
API_KEY=
SECRET_KEY=

# --- Étape 1 : simulation. Passe à false seulement après check_setup.py ------
DRY_RUN=true
# Fichier d'état séparé pour la simulation ; en live, utilise bot_state_live.json
STATE_FILE=bot_state_paper.json
SIM_STARTING_BALANCE=50

# Kraken vérifie le niveau de compte : starter | intermediate | pro
API_TIER=starter

# --- Paires en euros : pas de conversion EUR -> USD (ni frais ni spread) -----
QUOTE_CURRENCY=EUR
SYMBOLS=BTC/EUR,ETH/EUR,SOL/EUR

# --- 1h plutôt que 15m : stops plus larges, frais moins lourds par trade -------
TIMEFRAME=1h

# --- Une seule position : avec 50 €, elle mobilise déjà l'essentiel du capital -
MAX_OPEN_POSITIONS=1
RISK_PER_TRADE=0.02          # ≈ 1 € de perte max par trade
MAX_PORTFOLIO_RISK=0.03
MAX_POSITION_PCT=0.95

# --- Croissance : 100 % des gains réinvestis ----------------------------------
COMPOUND=true
COMPOUND_RATIO=1.0

# --- Pas de pyramiding : les ajouts tomberaient sous les minimums Kraken -------
PYRAMID_MAX_ADDS=0

# --- Garde-fou : arrêt si -10 % sur 7 jours (≈ -5 €) -----------------------------
MAX_WEEKLY_DRAWDOWN=0.10
FLATTEN_ON_HALT=true

LOG_LEVEL=INFO
