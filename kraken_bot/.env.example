# Copiez ce fichier en .env puis renseignez vos valeurs : cp .env.example .env
# Le fichier .env ne doit JAMAIS être commité.

# --- Clés API Kraken (Settings > API) ---------------------------------------
# Permissions nécessaires : Query Funds, Query Open Orders & Trades,
# Query Closed Orders & Trades, Create & Modify Orders, Cancel/Close Orders.
# NE PAS cocher "Withdraw Funds". Restreignez la clé à l'IP de votre VPS.
API_KEY=
SECRET_KEY=

# --- Modes --------------------------------------------------------------------
DRY_RUN=true                 # true = simulation (aucun ordre réel)
API_TIER=starter             # starter | intermediate | pro (niveau de vérification Kraken)

# --- Marchés ------------------------------------------------------------------
SYMBOLS=BTC/USD,ETH/USD,SOL/USD
QUOTE_CURRENCY=USD
TIMEFRAME=15m                # 15m ou 1h

# --- Stratégie ----------------------------------------------------------------
BB_PERIOD=20
BB_STD=2.0
VOLUME_SMA_PERIOD=20
VOLUME_MULTIPLIER=1.8
ADX_PERIOD=14
ADX_THRESHOLD=25
ATR_PERIOD=14
REQUIRE_FRESH_BREAKOUT=true
REQUIRE_DI_CONFIRMATION=true
REQUIRE_BANDWIDTH_EXPANSION=true
EXIT_ON_MID_BAND=false

# --- Stops --------------------------------------------------------------------
INITIAL_STOP_ATR=2.0
TRAILING_STOP_ATR=3.0
USE_EXCHANGE_STOP=true
STOP_UPDATE_MIN_ATR=0.25

# --- Risque -------------------------------------------------------------------
SIZING_MODE=fixed            # fixed | kelly (demi-Kelly avec KELLY_FRACTION=0.5)
RISK_PER_TRADE=0.02
MAX_RISK_PER_TRADE=0.03
KELLY_FRACTION=0.5
KELLY_LOOKBACK=50
KELLY_MIN_TRADES=20
KELLY_FLOOR=0.005
MAX_PORTFOLIO_RISK=0.06
MAX_OPEN_POSITIONS=3
MAX_POSITION_PCT=0.95
COMPOUND=true
COMPOUND_RATIO=0.5
MAX_WEEKLY_DRAWDOWN=0.10
FLATTEN_ON_HALT=true

# --- Pyramiding (0 = désactivé) -------------------------------------------------
PYRAMID_MAX_ADDS=0
PYRAMID_STEP_ATR=1.5
PYRAMID_RISK_SCALE=0.5

# --- Exécution ----------------------------------------------------------------
POST_ONLY=true
ORDER_TIMEOUT_SEC=45
MAX_REPRICE=3
ENTRY_CHASE_ATR=0.5
TAKER_FALLBACK=true
EXIT_POST_ONLY_FIRST=false
POLL_INTERVAL_SEC=10
WS_STALE_SEC=15
MAX_RETRIES=5

# --- Simulation / backtest ----------------------------------------------------
SIM_STARTING_BALANCE=10000
FEE_VOLUME_30D=0
SLIPPAGE_BPS=5

# --- Divers -------------------------------------------------------------------
# STATE_FILE=/home/trader/kraken_bot/bot_state.json
LOG_LEVEL=INFO
