# Profil "EXPLOSIF" : petites mises fixes sur beaucoup de cryptos très volatiles,
# trailing stop large pour laisser courir les rares envolées (+50 % / +100 %).
# Sur le serveur : kraken profil explosif   (garde tes clés et ton mode réel/simulation)

API_KEY=
SECRET_KEY=
DRY_RUN=true
STATE_FILE=bot_state_paper.json
SIM_STARTING_BALANCE=50
API_TIER=starter

# --- Beaucoup de paires volatiles en euros (celles absentes de Kraken sont ignorées) --
QUOTE_CURRENCY=EUR
SYMBOLS=SOL/EUR,XRP/EUR,DOGE/EUR,ADA/EUR,AVAX/EUR,LINK/EUR,DOT/EUR,SUI/EUR,PEPE/EUR,BONK/EUR,WIF/EUR,ETH/EUR,BTC/EUR
TIMEFRAME=1h

# --- Mise fixe de 5 € par trade, jusqu'à 8 paris en même temps -------------------
FIXED_STAKE=5
MAX_OPEN_POSITIONS=8
MAX_RISK_PER_TRADE=0.03      # perte au stop jamais > 3 % du capital (≈ 1,50 €)
MAX_PORTFOLIO_RISK=0.25
MAX_POSITION_PCT=0.95

# --- Entrées plus agressives -------------------------------------------------------
VOLUME_MULTIPLIER=2.0
ENTRY_CHASE_ATR=0.75
TAKER_FALLBACK=true

# --- Laisser courir : stop initial 2,5 ATR, trailing large à 4 ATR ----------------
INITIAL_STOP_ATR=2.5
TRAILING_STOP_ATR=4.0
PYRAMID_MAX_ADDS=0

# --- Coupe-circuit élargi : arrêt si -20 % sur 7 jours (≈ -10 €) -----------------
MAX_WEEKLY_DRAWDOWN=0.20
FLATTEN_ON_HALT=true

LOG_LEVEL=INFO
