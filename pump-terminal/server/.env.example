# ============ OBLIGATOIRE ============
# RPC Solana mainnet. Le RPC public est trop limité : utilisez Helius (gratuit pour démarrer), QuickNode, Triton…
# Exemple Helius : https://mainnet.helius-rpc.com/?api-key=VOTRE_CLE
SOLANA_RPC_URL=

# Mot de passe d'accès au terminal (à saisir dans Réglages). Indispensable si le serveur est sur Internet.
ACCESS_TOKEN=

# ============ IA GROK (optionnel mais recommandé) ============
# Clé API xAI : https://console.x.ai (payant à l'usage)
XAI_API_KEY=
# Modèle Grok (doit supporter l'outil x_search pour l'analyse de X)
XAI_MODEL=grok-4
# Analyse automatique des meilleurs candidats toutes les N minutes (0 = désactivé ; chaque analyse est facturée)
AI_AUTOSCAN_MINUTES=0

# ============ ALERTES 24h/24 SUR TÉLÉPHONE (optionnel) ============
# Créez un bot avec @BotFather, puis récupérez votre chat_id (ex. via @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============ DONNÉES / TRADING (valeurs par défaut correctes) ============
# Flux temps réel gratuit PumpPortal. Une clé PumpPortal (payante) ajoute les trades PumpSwap après migration.
PUMPPORTAL_API_KEY=
# Frais de l'API de transaction locale PumpPortal affichés dans l'aperçu (vérifiez sur pumpportal.fun)
PUMPPORTAL_FEE_PCT=0.5
# Jupiter (route alternative). lite-api est gratuit et limité ; api.jup.ag nécessite une clé (portal.jup.ag)
JUPITER_API_BASE=https://lite-api.jup.ag/swap/v1
JUPITER_API_KEY=

PORT=8080
DATA_DIR=./data
TRACK_MINUTES=45
MAX_TRACKED=600
