# ---------------------------------------------------------------
# Secrets et paramètres techniques de l'agent email.
# Copier ce fichier en ".env" puis remplir les valeurs.
# Ne JAMAIS committer le fichier .env.
# ---------------------------------------------------------------

# Clé API Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-remplacer-moi

# Modèle Claude utilisé pour la classification et la rédaction
MODEL=claude-sonnet-5-5

# Fichier OAuth "Application de bureau" téléchargé depuis Google Cloud
GOOGLE_CREDENTIALS_FILE=secrets/credentials.json

# Jeton OAuth généré par "python -m agent auth" (créé automatiquement)
GOOGLE_TOKEN_FILE=secrets/token.json

# Base SQLite (journal + file de validation + état de la relève)
DB_PATH=data/agent.db

# Dossier contenant entreprise.yaml, offres.yaml, reglages.yaml
CONFIG_DIR=config

# Niveau de log : DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
